{
    "name": "simply-at4dx",
    "displayName": "Simply AT4DX",
    "description": "Explore AT4DX Trigger Action Framework bindings for an SObject — execution order, criteria, and actions — without leaving VS Code.",
    "icon": "images/Simply_Logo.png",
    "publisher": "simplysf",
    "version": "2.3.1",
    "engines": {
        "vscode": "^1.119.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "salesforce",
        "at4dx",
        "apex",
        "trigger",
        "sfdx"
    ],
    "activationEvents": [
        "onCommand:simply-at4dx.showDomainProcessBindings"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "simply-at4dx.showDomainProcessBindings",
                "title": "AT4DX: Show Domain Process Bindings"
            }
        ],
        "configuration": {
            "title": "Simply AT4DX",
            "properties": {
                "simply-at4dx.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Log detailed binding lookups — including the org/source detail and captured error output — to the \"AT4DX Domain Process Bindings\" output channel. Turn this on when troubleshooting, reproduce the problem, then share the channel's contents in a bug report. Off by default since this detail can include org usernames and local file paths."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "node esbuild.js --production && tsc --noEmit -p .",
        "watch": "node esbuild.js --watch",
        "package": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.119.0",
        "esbuild": "^0.24.0",
        "typescript": "^5.6.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/SimplySF/simply-vscode.git",
        "directory": "extensions/simply-at4dx"
    },
    "dependencies": {
        "@salesforce/core": "^9.1.7",
        "@simplysf/simply-aep-core": "^0.5.0"
    }
}
